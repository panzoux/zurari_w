<Project>
  <!-- Quality gates applied to every project in the solution.
       Rule of thumb: the correct way to write code must also be the easiest way;
       everything else is rejected mechanically at build time. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Allow building net8.0-windows (WPF) projects on Linux CI / remote agents.
         Running WPF or its tests still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Per-layer API bans: a project opts in by having a BannedSymbols.txt next to its csproj. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\BannedSymbols.txt" Condition="Exists('$(MSBuildProjectDirectory)\BannedSymbols.txt')" />
  </ItemGroup>
</Project>
