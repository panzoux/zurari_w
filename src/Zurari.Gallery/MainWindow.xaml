<Window x:Class="Zurari.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zurari.Controls;assembly=Zurari.Controls"
        Title="Zurari.Controls Gallery" Height="700" Width="1200">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="LastEventText" Text="(no events yet)" />
            </StatusBarItem>
        </StatusBar>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBlock DockPanel.Dock="Left" Text="Dataset:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DatasetSelector" Width="220" HorizontalAlignment="Left"
                      SelectionChanged="OnDatasetSelected">
                <ComboBoxItem Content="Small" />
                <ComboBoxItem Content="Huge" />
                <ComboBoxItem Content="CJK" />
                <ComboBoxItem Content="Empty" />
                <ComboBoxItem Content="Deep" />
            </ComboBox>
        </DockPanel>
        <Grid Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <controls:ColumnBrowser x:Name="Browser" Grid.Column="0" />
            <!-- Preview pane placeholder (Phase 5 will fill this) -->
            <Border Grid.Column="1" Margin="8,0,0,0"
                    BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFF7F7F7">
                <TextBlock Text="preview" Foreground="#FF909090"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
