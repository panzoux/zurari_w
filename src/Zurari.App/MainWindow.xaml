<Window x:Class="Zurari.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zurari.App"
        xmlns:controls="clr-namespace:Zurari.Controls;assembly=Zurari.Controls"
        mc:Ignorable="d"
        Title="zurari" Height="600" Width="1000">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="(no state yet)" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <controls:ColumnBrowser x:Name="Browser" Grid.Column="0" />
            <!-- Preview pane placeholder (Phase 5 will fill this) -->
            <Border Grid.Column="1" Margin="8,0,0,0"
                    BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFF7F7F7">
                <TextBlock Text="preview" Foreground="#FF909090"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
