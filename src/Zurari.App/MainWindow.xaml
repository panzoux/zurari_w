<Window x:Class="Zurari.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zurari.App"
        xmlns:controls="clr-namespace:Zurari.Controls;assembly=Zurari.Controls"
        mc:Ignorable="d"
        Title="zurari" Height="600" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="(no state yet)" />
            </StatusBarItem>
        </StatusBar>
        <ItemsControl x:Name="JobStrip" DockPanel.Dock="Bottom" Margin="8,0,8,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFB0B0B0" BorderThickness="0,0,0,1" Padding="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Description}" FontSize="11" />
                                <ProgressBar Height="8" Width="160" Maximum="1" Margin="0,2,0,2"
                                             HorizontalAlignment="Left"
                                             Value="{Binding ProgressFraction, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#FF808080"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="上書き" FontSize="11" Padding="4,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobOverwriteClicked" />
                                <Button Content="スキップ" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobSkipConflictClicked" />
                                <Button Content="中止" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobCancelConflictClicked" />
                                <Button Content="キャンセル" FontSize="11" Padding="4,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobCancelClicked" />
                                <Button Content="×" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobDismissClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <!-- MinWidth on both sides keeps the splitter from pushing either the columns or
                     the preview out of the window; the star column absorbs window resizes. -->
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="280" MinWidth="150" />
            </Grid.ColumnDefinitions>
            <controls:ColumnBrowser x:Name="Browser" Grid.Column="0" />
            <!-- Focusable=False: a GridSplitter that takes keyboard focus consumes the arrow
                 keys for its own keyboard-resize feature and never gives focus back - after one
                 drag, cursor keys stopped reaching the ColumnBrowser. Mouse-only resizing. -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="False" Focusable="False" IsTabStop="False" />
            <Grid x:Name="PreviewPane" Grid.Column="2" Margin="2,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Where a deleted file came from; collapsed for everything else. No TextTrimming
                     on either of these: RenderPreview shortens them from the middle instead, which
                     is the only way a column of paths stays distinguishable. -->
                <TextBlock x:Name="PreviewOriginalPath" Grid.Row="0" FontSize="11"
                           Foreground="#FF707070" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewFileName" Grid.Row="1" Margin="0,0,0,4" FontWeight="Bold" />
                <Border Grid.Row="2" BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFF7F7F7">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBox x:Name="PreviewTextBox" IsReadOnly="True" TextWrapping="NoWrap"
                                 AcceptsReturn="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" Visibility="Collapsed" />
                        <!-- How full a drive, a share, or the bin is. The bar is two star-sized
                             grid columns, so the ratio is the layout rather than arithmetic over a
                             width that is not known until the splitter stops moving. -->
                        <StackPanel x:Name="PreviewCapacityPanel" Margin="12" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="PreviewCapacitySummary" TextAlignment="Center"
                                       Foreground="#FF404040" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Border x:Name="PreviewCapacityBar" BorderBrush="#FFB0B0B0" BorderThickness="1"
                                    Background="#FFFFFFFF" Height="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="PreviewCapacityUsed" Width="0*" />
                                        <ColumnDefinition x:Name="PreviewCapacityFree" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#FF3A86E0" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PreviewCapacityFreeText" TextAlignment="Center" FontSize="11"
                                       Foreground="#FF707070" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="PreviewMeta" Foreground="#FF909090" Margin="8"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <Border Grid.Row="3" BorderBrush="#FFB0B0B0" BorderThickness="1,0,1,1" Background="#FFF0F0F0"
                        Padding="6,4">
                    <TextBlock x:Name="PreviewMetadataBlock" FontSize="11" TextWrapping="Wrap"
                               Foreground="#FF404040" Visibility="Collapsed" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
