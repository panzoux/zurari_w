<Window x:Class="Zurari.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zurari.App"
        xmlns:controls="clr-namespace:Zurari.Controls;assembly=Zurari.Controls"
        mc:Ignorable="d"
        Title="zurari for Windows" Height="600" Width="1000" MinHeight="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <!-- A grid, not the default DockPanel: the hints take what is left and trim, so a long hint
             string can never push the summary off the right edge. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusHints" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusSummary" Text="(no state yet)" />
            </StatusBarItem>
        </StatusBar>
        <!-- Path bar: the full path of what the cursor is on. While a / search or a Leap is open the
             mode bar takes its place (7b): a prefix (/ or LEAP and the trail), a real text box - so IME
             and Backspace work as anywhere else - and the match count. MainWindow.Modes.cs drives it. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFB0B0B0" BorderThickness="0,1,0,0" Padding="6,2">
            <Grid>
                <TextBlock x:Name="PathBarText" TextTrimming="CharacterEllipsis" />
                <DockPanel x:Name="ModeBar" Visibility="Collapsed" LastChildFill="True">
                    <TextBlock x:Name="ModePrefix" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="#FF808080" Margin="0,0,4,0" />
                    <TextBlock x:Name="ModeStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                    <TextBox x:Name="ModeBox" BorderThickness="0" Padding="0" Background="#FFFFFBE0"
                             PreviewKeyDown="OnModeBoxPreviewKeyDown" TextChanged="OnModeBoxTextChanged"
                             LostKeyboardFocus="OnModeBoxLostKeyboardFocus" />
                </DockPanel>
            </Grid>
        </Border>
        <!-- Deliberately uncapped: a job row can hold the conflict prompt's buttons, and a waiting
             prompt must never scroll out of sight. Window MinHeight 400 = 2 x 120 panes + 6 splitter
             + status bar ~24 + path bar ~21 + this strip (4 margin + one job row ~55) + ~39 title bar
             and frame, rounded up. It allows for one job row; with more jobs on a minimum-size window
             the panes are squeezed, by choice. -->
        <ItemsControl x:Name="JobStrip" DockPanel.Dock="Bottom" Margin="8,0,8,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFB0B0B0" BorderThickness="0,0,0,1" Padding="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Description}" FontSize="11" />
                                <ProgressBar Height="8" Width="160" Maximum="1" Margin="0,2,0,2"
                                             HorizontalAlignment="Left"
                                             Value="{Binding ProgressFraction, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" />
                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#FF808080"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="上書き" FontSize="11" Padding="4,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobOverwriteClicked" />
                                <Button Content="スキップ" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobSkipConflictClicked" />
                                <Button Content="中止" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsWaitingConflict, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobCancelConflictClicked" />
                                <Button Content="キャンセル" FontSize="11" Padding="4,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobCancelClicked" />
                                <Button Content="×" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnJobDismissClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Two rows of panes. The second row and the splitter are collapsed (height 0) until the
             split opens; Render sizes them. -->
        <Grid x:Name="PaneRows">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" MinHeight="120" />
                <RowDefinition x:Name="SplitterRow" Height="0" />
                <RowDefinition x:Name="BottomRow" Height="0" MinHeight="0" />
            </Grid.RowDefinitions>
            <local:PaneView x:Name="TopPane" Grid.Row="0" />
            <!-- Focusable=False: a focused GridSplitter eats the arrow keys (see the preview splitter). -->
            <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" Background="Transparent" ShowsPreview="False"
                          Focusable="False" IsTabStop="False" Visibility="Collapsed" />
            <local:PaneView x:Name="BottomPane" Grid.Row="2" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
