<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Zurari.Controls">

    <Style TargetType="{x:Type local:ColumnBrowser}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFB0B0B0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColumnBrowser}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_HorizontalScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel x:Name="PART_ColumnsPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ColumnView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColumnView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Top" x:Name="HeaderBorder">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Column.IsFocused, RelativeSource={RelativeSource TemplatedParent}}"
                                                Value="True">
                                                <Setter Property="Background" Value="#FFDCE8FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Padding="6,4"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Column.Title, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <ListBox x:Name="PART_List"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemsSource="{Binding Column.Entries, RelativeSource={RelativeSource TemplatedParent}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,2" />
                                        <Style.Triggers>
                                            <!-- Cursor row: selection reflects ColumnVm.CursorIndex only
                                                 (ColumnView keeps SelectedIndex in sync; it never lets
                                                 a stray user selection stick). Weak highlight by default -
                                                 columns behind the focused one still show where the cursor
                                                 was left, Finder-style. -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFD6D6D6" />
                                            </Trigger>
                                            <!-- Strong highlight only in the focused column. IsColumnFocused
                                                 is an inheritable attached property set once on the owning
                                                 ColumnView, not on WPF's own keyboard-focus state, so the
                                                 accent tracks ColumnVm.IsFocused regardless of which element
                                                 actually has keyboard focus. -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True" />
                                                    <Condition Property="local:ColumnView.IsColumnFocused" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="#FF3D8AE2" />
                                                <Setter Property="Foreground" Value="White" />
                                            </MultiTrigger>
                                            <!-- Marked entries (multi-selection) stay visibly distinct
                                                 regardless of cursor/selection state. -->
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="#FF0A5FBF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="8,0,0,0"
                                                       Foreground="Gray"
                                                       Text="{Binding SizeText}" />
                                            <TextBlock TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <Thumb x:Name="PART_ResizeThumb"
                               Grid.Column="1"
                               Width="5"
                               Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="Transparent"
                                            BorderBrush="#FFB0B0B0"
                                            BorderThickness="0,0,1,0" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
