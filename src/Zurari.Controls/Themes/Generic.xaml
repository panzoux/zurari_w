<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Zurari.Controls">

    <Style TargetType="{x:Type local:ColumnBrowser}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#FFB0B0B0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColumnBrowser}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_HorizontalScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel x:Name="PART_ColumnsPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ColumnView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColumnView}">
                    <Border x:Name="DropTargetBorder"
                            BorderThickness="2"
                            BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Top" x:Name="HeaderBorder">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Column.IsFocused, RelativeSource={RelativeSource TemplatedParent}}"
                                                Value="True">
                                                <Setter Property="Background" Value="#FFDCE8FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Padding="6,4"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Column.Title, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <Grid>
                            <ListBox x:Name="PART_List"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Focusable="False"
                                     ItemsSource="{Binding Column.Entries, RelativeSource={RelativeSource TemplatedParent}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Item">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <!-- Keyboard focus must stay on ColumnBrowser (the only element that
                                             translates input into events); rows are never independently
                                             focusable/tab-stoppable, mouse hit-testing still works fine. -->
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,2" />
                                        <!-- Minimal template: the DEFAULT ListBoxItem template paints
                                             selected rows with the OS theme's (inactive-)selection
                                             brushes on an internal Border, OVERRIDING the Background
                                             set by the triggers below - which made the cursor row of
                                             a fresh multi-selection look gray instead of the marked
                                             blue. A bare Border bound to Background keeps this style
                                             the single source of row colors. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- Trigger ORDER is deliberate (later triggers win when several
                                             apply at once - standard WPF style-trigger precedence):
                                               1. IsSelected (weak cursor, #FFE0E0E0)
                                               2. IsRubberBandHover (#FFE3F0FB) - live drag preview; a row
                                                  merely hovered by an in-progress rubber-band is a weaker,
                                                  more ephemeral signal than the persistent cursor/marked
                                                  states below, but it should still read over the plain
                                                  weak-cursor background so the user can see the drag doing
                                                  something.
                                               3. IsMarked (#FFCCE8FF) - persistent multi-selection state;
                                                  wins over both the weak cursor and the hover preview, so a
                                                  marked row in an unfocused column stays visibly marked even
                                                  while a rubber-band is passing over some other row.
                                               4. IsDropTargetRow (#FFB3D3F2, strong selection blue) - the
                                                  single row a file drag is hovering, when it is a Directory
                                                  or Drive (set by ColumnView.OnDragOver, cleared on every
                                                  other container each update). Deliberately wins over
                                                  IsMarked/IsRubberBandHover/weak-cursor: the receiving
                                                  directory must read unambiguously as "drop here", not be
                                                  muddied by whatever selection state it happened to already
                                                  have.
                                               5. IsSelected + IsColumnFocused (#FFB3D3F2, strong cursor) -
                                                  last, so the cursor row in the FOCUSED column always reads
                                                  as the strong cursor blue even when also marked; unfocused
                                                  columns never get this trigger; their marked rows show only
                                                  the weaker step 3 background as a result. Same color as
                                                  step 4 by design (a drop-target row and the strong cursor
                                                  row are meant to look identical when they coincide).
                                             IsCut (below, outside this numbered list) dims the whole row via
                                             Opacity rather than Background, so it layers independently of
                                             the precedence above - a cut row keeps whatever
                                             selection/marked/hover background it would otherwise have, just
                                             faded, Explorer-style, until the pending cut is consumed by a
                                             paste or replaced by a new cut/copy. -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                            <!-- Cursor row: selection reflects ColumnVm.CursorIndex only
                                                 (ColumnView keeps SelectedIndex in sync; it never lets
                                                 a stray user selection stick). Weak highlight by default -
                                                 columns behind the focused one still show where the cursor
                                                 was left, Finder-style. -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFE0E0E0" />
                                            </Trigger>
                                            <!-- Live rubber-band drag preview (R2): IsRubberBandHover is
                                                 set directly on the container (not inherited) by ColumnView
                                                 while the row falls inside the drag's current index range;
                                                 cleared on every move/release. Lighter than a real mark. -->
                                            <Trigger Property="local:ColumnView.IsRubberBandHover" Value="True">
                                                <Setter Property="Background" Value="#FFE3F0FB" />
                                            </Trigger>
                                            <!-- Marked entries (multi-selection): Explorer/Finder-style row
                                                 background instead of bold+colored text, so marked rows
                                                 read the same way as a native file manager's selection. -->
                                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                <Setter Property="Background" Value="#FFCCE8FF" />
                                            </DataTrigger>
                                            <!-- Explorer (or other app) file drag currently hovering this
                                                 row, which is a Directory or Drive: set directly on the
                                                 container by ColumnView.OnDragOver, cleared on DragLeave/
                                                 Drop/every update. Reads as the strong selection blue so the
                                                 receiving directory looks exactly like a selected row. -->
                                            <Trigger Property="local:ColumnView.IsDropTargetRow" Value="True">
                                                <Setter Property="Background" Value="#FFB3D3F2" />
                                            </Trigger>
                                            <!-- Strong highlight only in the focused column. IsColumnFocused
                                                 is an inheritable attached property set once on the owning
                                                 ColumnView, not on WPF's own keyboard-focus state, so the
                                                 accent tracks ColumnVm.IsFocused regardless of which element
                                                 actually has keyboard focus. Declared last so cursor+marked
                                                 in the focused column reads as the strong cursor blue. -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True" />
                                                    <Condition Property="local:ColumnView.IsColumnFocused" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="#FFB3D3F2" />
                                            </MultiTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="4,0,0,0"
                                                       Foreground="Gray">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="&#x203A;" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Directory">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Drive">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="8,0,0,0"
                                                       Foreground="Gray"
                                                       Text="{Binding SizeText}" />
                                            <Image DockPanel.Dock="Left"
                                                   Width="16"
                                                   Height="16"
                                                   Margin="0,0,4,0"
                                                   SnapsToDevicePixels="True"
                                                   UseLayoutRounding="True"
                                                   Source="{Binding Icon}" />
                                            <TextBlock TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Rubber-band (rectangle) select feedback. Positioned in code
                                 (ColumnView) via Canvas.Left/Top and Width/Height; hidden
                                 (Collapsed) except during an active drag. IsHitTestVisible=False
                                 so it never steals the mouse events PART_List needs to keep
                                 tracking the drag. -->
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="PART_RubberBand"
                                           Visibility="Collapsed"
                                           Fill="#3399CCFF"
                                           Stroke="#FF3399CC"
                                           StrokeThickness="1" />
                            </Canvas>
                            </Grid>
                        </DockPanel>
                        <Thumb x:Name="PART_ResizeThumb"
                               Grid.Column="1"
                               Width="5"
                               Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="Transparent"
                                            BorderBrush="#FFB0B0B0"
                                            BorderThickness="0,0,1,0" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Highlights the whole column while an Explorer (or other app) drag with
                             file data is hovering over it. IsDropTarget is an inheritable attached
                             property set by ColumnView itself on DragOver/DragLeave/Drop. -->
                        <Trigger Property="local:ColumnView.IsDropTarget" Value="True">
                            <Setter TargetName="DropTargetBorder" Property="BorderBrush" Value="#FF3A86E0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
